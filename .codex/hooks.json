{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.agents/hooks/post-edit.py\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; python (Join-Path $root '.agents/hooks/post-edit.py')\"",
            "timeout": 30,
            "statusMessage": "Post-edit: ruff format, skill sync"
          }
        ]
      }
    ]
  }
}
