# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# Tools
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local data & archives
*.csv
*.xlsx
*.txt
*.html
# Synthetic test inputs and expected reports
!tests/fixtures/**/*.csv
!tests/fixtures/scraper/*.html
!tests/golden/*.csv
!tests/golden/scraper/**/*.csv
# The results page's expected page
!tests/golden/page/*.html

# Ignore all data by default
data/**/*
# Unignore only the directory structure
!data/**/
# Allow only files ending in _example.csv anywhere in data
!data/**/*_example.csv
mutants/
